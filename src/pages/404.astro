---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ページが見つかりません | 合同会社語音">
  <section class="mx-auto max-w-2xl px-5 pt-24 pb-24 text-center">
    <p class="ipa text-5xl text-teal-700">[ 404 ]</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-ink">
      ページが見つかりません
    </h1>
    <p class="mt-3 text-muted">
      お探しのページは移動または削除された可能性があります。
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-teal px-5 py-2.5 text-sm font-medium text-white no-underline hover:bg-teal-700"
      >ホームへ戻る</a
    >
  </section>
</BaseLayout>

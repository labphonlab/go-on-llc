---
import BaseLayout from "../layouts/BaseLayout.astro";
import VowelChart from "../components/islands/VowelChart.tsx";
import Spectrogram from "../components/islands/Spectrogram.tsx";
import { u } from "../lib/url";
import { released } from "../data/catalog";
---

<BaseLayout
  title="ツール"
  description="ブラウザ上で動く音声学の学習・研究ツール。IPA母音四角形、波形＋スペクトログラム表示のほか、母音フォルマントチャート・Praat JA・識別課題アプリを公開しています。"
>
  <section class="mx-auto max-w-5xl px-5 pt-16 pb-10">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">tools</p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink">
      ツール
    </h1>
    <p class="mt-5 max-w-2xl leading-relaxed text-muted">
      音声学の学習・研究に使えるツールです。このページのデモはインストール不要でその場で動きます。単独のアプリケーションとして公開しているものは下にまとめています。
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-16">
    <h2 class="text-xs uppercase tracking-[0.25em] text-muted">
      このページで動くデモ
    </h2>

    <div class="mt-8 rounded-xl border border-line bg-paper p-6 sm:p-8">
      <h3 class="font-display text-xl text-ink">IPA母音四角形</h3>
      <p class="mt-1 mb-6 text-sm text-muted">
        基本母音と曖昧母音（schwa）。各母音をクリック（またはキーボードで選択）すると説明が表示されます。
      </p>
      <!-- client:visible = hydrate this React island only when scrolled into view -->
      <VowelChart client:visible />
    </div>

    <div class="mt-8 rounded-xl border border-line bg-paper p-6 sm:p-8">
      <h3 class="font-display text-xl text-ink">波形＋スペクトログラム</h3>
      <p class="mt-1 mb-6 text-sm text-muted">
        WaveSurfer.js による音声ビューア。サンプルを再生するか、手元の音声ファイルを開いて時間—周波数構造を確認できます。ファイルはブラウザ内で読み込まれ、外部へ送信されません。
      </p>
      <!-- client:visible = 重い依存を含む island はスクロールで初めて水和 -->
      <Spectrogram client:visible />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-24">
    <div class="border-t border-line pt-10">
      <h2 class="text-xs uppercase tracking-[0.25em] text-muted">
        公開しているツール
      </h2>
      <div class="mt-8 border-t border-line">
        {
          released.map((p) => (
            <div class="grid gap-x-8 gap-y-2 border-b border-line py-6 sm:grid-cols-[1fr_auto]">
              <div>
                <h3 class="font-display text-lg text-ink">
                  {p.name}
                  <span class="ml-2 text-xs text-muted">· {p.kind}</span>
                </h3>
                <p class="mt-1 max-w-2xl text-sm leading-relaxed text-muted">
                  {p.summary}
                </p>
              </div>
              {p.links?.[0] && (
                <a
                  href={p.links[0].href}
                  class="self-start text-sm font-medium text-ink no-underline underline-offset-[6px] hover:underline sm:pt-1"
                >
                  {p.links[0].label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-muted">
        詳しい説明と動作環境は<a href={u("/products")}>プロダクト</a>ページに、
        ご利用上のご質問は<a href={u("/support")}>サポート</a>にまとめています。今後、IPA子音チャートとフォルマント分析を追加する予定です。
      </p>
    </div>
  </section>
</BaseLayout>

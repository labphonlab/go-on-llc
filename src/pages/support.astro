---
import BaseLayout from "../layouts/BaseLayout.astro";
import { u } from "../lib/url";
import { released } from "../data/catalog";

/** 不具合報告に必要な情報。contact ページからも参照される。 */
const reportItems = [
  "製品名とバージョン",
  "OSと機種（例: iPadOS 26 / iPad Air 11インチ M2）",
  "どう操作すると起きるか（再現手順）",
  "期待した動作と、実際に起きたこと",
];

const faq = [
  {
    q: "返信までどのくらいかかりますか。",
    a: "内容を確認のうえ、順次ご返信しています。再現手順が添えられているご報告から先に着手できるため、上記の4点をご記入いただけると早く進みます。",
  },
  {
    q: "録音した音声や入力したデータは外部に送信されますか。",
    a: "送信しません。音声分析アプリの解析は端末内で完結し、Webツールの入力値・読み込んだ音声ファイル・測定結果はブラウザ内だけで処理されます。当社は閲覧者を追跡するCookieやアクセス解析ツールも使用していません。詳細は プライバシーポリシー をご覧ください。",
    link: { label: "プライバシーポリシー", href: "/legal#privacy" },
  },
  {
    q: "購入や返金の手続きはどこで行いますか。",
    a: "App Store で販売する製品およびアプリ内課金の決済・返金は Apple が管理しています。返金のご依頼は Apple のサポート（reportaproblem.apple.com）へお申し出ください。購入内容についてのご質問は当社でもお答えします。",
  },
  {
    q: "授業や研究で使ってもよいですか。",
    a: "公開中のツールは、授業・研究にそのままお使いいただけます。出典としてお示しいただく必要はありませんが、示していただける場合は「合同会社語音」または各ツール名をご記載ください。まとまった台数への導入、学内配布、カスタマイズのご相談も承ります。",
  },
  {
    q: "要望や改善の提案を送ってもよいですか。",
    a: "歓迎します。実際の使い方に沿ったご要望は、次に何をつくるかの判断に直接反映しています。お問い合わせフォームからお送りください。",
  },
];
---

<BaseLayout
  title="サポート"
  description="合同会社語音の製品サポート。Praat JA・母音フォルマントチャート・音声知覚識別課題アプリの使い方と注意点、不具合の報告方法、データの取り扱いについて。"
>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-12">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">support</p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink">
      サポート
    </h1>
    <p class="mt-5 leading-relaxed text-muted">
      当社の製品についてのご質問、不具合のご報告、ご要望をお受けします。個人・法人を問わずご利用いただけます。対応言語は日本語および英語です。
    </p>

    <div class="mt-8 rounded-xl border border-line bg-white/60 p-6 sm:p-8">
      <h2 class="font-display text-xl text-ink">お問い合わせ窓口</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        <a href={u("/contact")}>お問い合わせフォーム</a>
        よりご連絡ください。不具合のご報告では、次の4点を添えていただけると再現が早く進みます。
      </p>
      <ol class="mt-4 grid gap-1.5 text-sm text-ink">
        {
          reportItems.map((item, i) => (
            <li class="grid grid-cols-[1.75rem_1fr] items-baseline">
              <span class="ipa text-sm text-muted">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm leading-relaxed text-muted">
        エラーが表示される場合は、その文言か画面の写真も添えてください。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16">
    <h2 class="text-xs uppercase tracking-[0.25em] text-muted">製品ごとの案内</h2>
    <p class="mt-4 text-sm leading-relaxed text-muted">
      共通のご質問は下の「よくあるご質問」に、各製品に固有の注意点はここにまとめています。
    </p>

    <div class="mt-8 grid gap-5">
      {
        released.map((p) => (
          <article class="rounded-xl border border-line bg-white/60 p-6 sm:p-8">
            <h3 class="font-display text-xl text-ink">{p.name}</h3>
            <p class="mt-1 text-sm text-muted">
              {p.kind} · 動作環境: {p.platforms}
            </p>
            {p.support && (
              <ul class="mt-4 grid gap-2.5 text-sm leading-relaxed text-muted">
                {p.support.map((line) => (
                  <li class="grid grid-cols-[0.75rem_1fr] gap-x-2">
                    <span aria-hidden="true" class="text-line">
                      —
                    </span>
                    <span>{line}</span>
                  </li>
                ))}
              </ul>
            )}
            {p.note && (
              <p class="mt-4 border-l-2 border-amber pl-3 text-xs leading-relaxed text-muted">
                {p.note}
              </p>
            )}
            {p.links && (
              <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                {p.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="font-medium text-ink no-underline underline-offset-[6px] hover:underline"
                    >
                      {l.label} <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-24">
    <div class="border-t border-line pt-10">
      <h2 class="font-display text-2xl text-ink">よくあるご質問</h2>
      <dl class="mt-8 border-t border-line">
        {
          faq.map((item) => (
            <div class="border-b border-line py-6">
              <dt class="font-display text-lg leading-snug text-ink">
                {item.q}
              </dt>
              <dd class="mt-2 text-sm leading-relaxed text-muted">
                {item.link ? (
                  <>
                    {item.a.split(item.link.label)[0]}
                    <a href={u(item.link.href)}>{item.link.label}</a>
                    {item.a.split(item.link.label)[1]}
                  </>
                ) : (
                  item.a
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-8 text-sm leading-relaxed text-muted">
        ここで解決しない場合は、<a href={u("/contact")}>お問い合わせフォーム</a
        >からご連絡ください。各製品の内容は<a href={u("/products")}>プロダクト</a
        >ページにあります。
      </p>
    </div>
  </section>
</BaseLayout>

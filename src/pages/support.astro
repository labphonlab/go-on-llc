---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { u } from "../lib/url";
import { tools } from "../data/catalog";

/** 不具合報告に必要な情報。フォーム側の項目と対応している。 */
const reportItems = [
  "製品名とバージョン",
  "OSと機種（フォームでは自動取得します）",
  "どう操作すると起きるか（再現手順）",
  "期待した動作と、実際に起きたこと",
];

/**
 * 製品をまたぐ質問だけをここに置く。個々の製品に固有の注意点は
 * catalog.ts の support に持たせ、上の「製品ごとの案内」に出す。
 */
const faq = [
  {
    id: "reply",
    q: "返信までどのくらいかかりますか。",
    a: "内容を確認のうえ、順次ご返信しています。再現手順が添えられているご報告から先に着手できるため、フォームの項目を埋めていただくほど早く進みます。数日経っても届かない場合は、迷惑メールフォルダをご確認のうえ、お手数ですがもう一度お送りください。",
  },
  {
    id: "language",
    q: "日本語以外でも問い合わせできますか。",
    a: "日本語と英語でお受けしています。どちらでも同じ窓口をご利用ください。",
  },
  {
    id: "privacy",
    q: "録音した音声や入力したデータは外部に送信されますか。",
    a: "送信しません。音声分析アプリの解析は端末内で完結し、Webツールの入力値・読み込んだ音声ファイル・測定結果はブラウザ内だけで処理されます。当社は閲覧者を追跡するCookieやアクセス解析ツールも使用していません。",
    link: { label: "プライバシーポリシーを見る", href: "/legal#privacy" },
  },
  {
    id: "data-loss",
    q: "作業中のデータが消えてしまいました。",
    a: "Webツールは結果をブラウザ内にしか保持しません。ページを閉じる・再読み込みする・別のページへ移動すると、その回のデータは失われます。復元はできないため、測定や試行が終わった時点で PNG・CSV に書き出してください。当社側にはデータが残らないため、こちらから復元することもできません。",
  },
  {
    id: "purchase",
    q: "購入や返金の手続きはどこで行いますか。",
    a: "App Store で販売する製品およびアプリ内課金の決済・返金は Apple が管理しています。返金のご依頼は Apple のサポート（reportaproblem.apple.com）へお申し出ください。購入内容についてのご質問は当社でもお答えします。",
  },
  {
    id: "education",
    q: "授業や研究で使ってもよいですか。",
    a: "授業・研究でのご利用を歓迎します。ソフトウェアはサイトからの一般配布を行っていないため、ご希望の対象と用途を添えてお問い合わせください。機関での導入、学内配布、仕様に合わせた調整もご相談いただけます。",
  },
  {
    id: "customize",
    q: "研究用に仕様を変えて使いたいのですが。",
    a: "刺激リストや選択肢の差し替えなど、研究目的での調整はご相談ください。用途をうかがったうえで、対応できる範囲をお伝えします。ご自身で改変されたものについては、当社のサポート対象外となる点をご了承ください。",
  },
  {
    id: "request",
    q: "要望や改善の提案を送ってもよいですか。",
    a: "歓迎します。実際の使い方に沿ったご要望は、次に何をつくるかの判断に直接反映しています。フォームの「機能のご要望」からお送りください。",
  },
];
---

<BaseLayout
  title="サポート"
  description="合同会社語音の製品サポート。Praat JA・母音フォルマントチャート・音声知覚識別課題アプリの使い方と注意点、不具合の報告方法、データの取り扱いについて。"
>
  <PageHeader
    eyebrow="support"
    title="サポート"
    lead={`当社の製品についてのご質問、不具合のご報告、ご要望をお受けします。個人・法人を問わずご利用いただけます。対応言語は日本語および英語です。`}
  />

  <section class="mx-auto max-w-3xl px-5 pb-16">
    <div class="card p-7 sm:p-9">
      <h2 class="font-display text-xl text-ink">お問い合わせ窓口</h2>
      <p class="mt-3 leading-relaxed text-muted">
        フォームはご用件に応じて必要な項目だけを表示し、動作環境は自動で取得します。不具合のご報告では次の4点をうかがいます。
      </p>
      <ol class="mt-4 grid gap-1.5 text-sm text-ink">
        {
          reportItems.map((item, i) => (
            <li class="grid grid-cols-[1.75rem_1fr] items-baseline">
              <span class="ipa text-sm text-muted">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
      <a
        href={u("/contact")}
        class="mt-6 inline-block rounded-md bg-ink px-6 py-3 text-sm font-medium text-paper no-underline transition-opacity hover:opacity-85"
        >お問い合わせフォームへ</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16">
    <h2 class="eyebrow">製品ごとの案内</h2>
    <div class="mt-8 grid gap-5">
      {
        tools.map((p) => (
          <article id={p.id} class="card scroll-mt-28 p-7 sm:p-9">
            <h3 class="font-display text-xl text-ink">{p.name}</h3>
            <p class="mt-1 text-sm text-muted">
              {p.kind} · 動作環境: {p.platforms}
            </p>
            {p.support && (
              <ul class="mt-4 grid gap-2.5 text-sm leading-relaxed text-muted">
                {p.support.map((line) => (
                  <li class="grid grid-cols-[0.75rem_1fr] gap-x-2">
                    <span aria-hidden="true" class="text-line">
                      —
                    </span>
                    <span>{line}</span>
                  </li>
                ))}
              </ul>
            )}
            {p.note && (
              <p class="mt-4 border-l-2 border-amber pl-3 text-xs leading-relaxed text-muted">
                {p.note}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-24">
    <div class="border-t border-line pt-12">
      <h2 class="eyebrow">よくあるご質問</h2>

      <!--
        絞り込みは進歩的強化。JSが無くても全項目がそのまま読める（回答はHTMLに
        含まれるので検索エンジンにも渡る）。
      -->
      <div class="mt-6" data-faq>
        <label class="grid gap-1.5">
          <span class="sr-only">質問を絞り込む</span>
          <input
            type="search"
            data-faq-input
            placeholder="キーワードで絞り込む（例: 返金、データ、授業）"
            class="w-full rounded-md border border-line bg-white px-3 py-2 text-ink transition-colors focus:border-ink focus:outline-none"
          />
        </label>
        <p class="mt-2 text-xs text-muted" data-faq-count aria-live="polite"></p>

        <div class="mt-6 border-t border-line">
          {
            faq.map((item) => (
              <details id={item.id} class="row scroll-mt-24 py-1" data-faq-item>
                <summary class="cursor-pointer list-none py-4 font-display text-lg leading-snug text-ink marker:content-['']">
                  {item.q}
                </summary>
                <div class="pb-5 text-sm leading-relaxed text-muted">
                  <p>{item.a}</p>
                  {item.link && (
                    <a
                      href={u(item.link.href)}
                      class="mt-2 inline-block font-medium text-ink no-underline underline-offset-[7px] hover:underline"
                    >
                      {item.link.label} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </details>
            ))
          }
        </div>

        <p class="mt-6 hidden text-sm text-muted" data-faq-empty>
          該当する質問がありませんでした。<a href={u("/contact")}
            >お問い合わせフォーム</a
          >からお送りください。
        </p>
      </div>

      <p class="mt-8 leading-relaxed text-muted">
        ここで解決しない場合は<a href={u("/contact")}>お問い合わせ</a
        >ください。各製品の内容は<a href={u("/products")}>プロダクト</a
        >ページにあります。
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // FAQ の絞り込み。該当件数を読み上げ、ヒットした項目は開いた状態で示す。
  const root = document.querySelector<HTMLElement>("[data-faq]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-faq-input]")!;
    const items = [...root.querySelectorAll<HTMLDetailsElement>("[data-faq-item]")];
    const count = root.querySelector<HTMLElement>("[data-faq-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-faq-empty]")!;

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let hits = 0;
      for (const item of items) {
        const match = !q || (item.textContent ?? "").toLowerCase().includes(q);
        item.hidden = !match;
        item.open = Boolean(q) && match;
        if (match) hits++;
      }
      count.textContent = q ? `${hits}件の質問が該当しました。` : "";
      empty.classList.toggle("hidden", hits > 0);
    };

    input.addEventListener("input", apply);

    // /support#purchase のような直リンクは、その項目を開いて見せる。
    const openFromHash = () => {
      const target = location.hash ? document.querySelector(location.hash) : null;
      if (target instanceof HTMLDetailsElement) target.open = true;
    };
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  }
</script>

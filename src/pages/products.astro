---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { u } from "../lib/url";
import { tools } from "../data/catalog";
---

<BaseLayout
  title="プロダクト"
  description="合同会社語音が公開しているソフトウェア。Praat JA（Praatの日本語GUI）、母音フォルマントチャート、音声知覚の識別課題アプリ。"
>
  <PageHeader
    eyebrow="products"
    title="プロダクト"
    lead={`音声を扱うソフトウェアを自社で開発しています。研究・教育の現場で必要になった道具を、そのつどつくってきたものです。いずれもサイトからの一般配布は行っていません。ご利用をご希望の場合はお問い合わせください。`}
  />

  <section class="mx-auto max-w-5xl px-5 pb-16">
    <div class="grid gap-5">
      {
        tools.map((p) => (
          <article class="card p-7 sm:p-9">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="font-display text-2xl text-ink">{p.name}</h3>
              <span class="text-xs text-muted">{p.kind}</span>
            </div>
            <p class="mt-3 text-ink">{p.summary}</p>
            <p class="mt-3 leading-relaxed text-muted">{p.detail}</p>
            <p class="mt-4 text-sm text-muted">
              <span class="text-xs tracking-wider text-muted">動作環境</span>{" "}
              {p.platforms}
            </p>
            {p.note && (
              <p class="mt-4 border-l-2 border-amber pl-3 text-xs leading-relaxed text-muted">
                {p.note}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-24">
    <div class="card p-7 sm:p-9">
      <h2 class="font-display text-xl text-ink">ご利用について</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">
        いずれのソフトウェアもサイトからの一般配布は行っていません。授業・研究でのご利用、機関での導入、仕様に合わせた調整のご相談は、対象のソフトウェア名を添えてお問い合わせください。動作環境や制約についてのご質問にもお答えします。
      </p>
      <a
        href={u("/contact")}
        class="mt-6 inline-block rounded-md bg-ink px-6 py-3 text-sm font-medium text-paper no-underline transition-opacity hover:opacity-85"
        >お問い合わせフォームへ</a
      >
    </div>
  </section>
</BaseLayout>

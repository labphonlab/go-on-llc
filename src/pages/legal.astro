---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { u } from "../lib/url";

const tokushoho = [
  { k: "事業者名", v: "合同会社語音" },
  { k: "代表社員", v: "石原 健" },
  { k: "所在地", v: "〒170-0012 東京都豊島区上池袋4-10-8-709" },
  { k: "電話番号", v: "070-9481-0649" },
  {
    k: "お問い合わせ",
    v: "本サイトの問い合わせフォーム",
    href: "/contact",
    hint: "内容の記録が残るため、お問い合わせはフォームからお願いしています。",
  },
  {
    k: "販売価格",
    v: "各プロダクトの販売ページ（App Store 等）に表示します。",
  },
  {
    k: "代金の支払時期・方法",
    v: "各配信プラットフォームの定めによります。App Store 経由のアプリおよびアプリ内課金は Apple が決済を行います。",
  },
  {
    k: "商品の引渡時期",
    v: "決済完了後、ただちにダウンロードまたは機能の利用が可能になります。",
  },
  {
    k: "返品・キャンセル",
    v: "デジタル商品の性質上、当社からの直接の返金は承っておりません。App Store 経由でご購入の場合、返金は Apple のポリシーに従い、Apple のサポート（reportaproblem.apple.com）へお申し出ください。",
  },
  {
    k: "動作環境",
    v: "各プロダクトの説明ページに記載します。",
    href: "/products",
  },
];
---

<BaseLayout
  title="特定商取引法に基づく表記・プライバシーポリシー"
  description="合同会社語音の特定商取引法に基づく表記およびプライバシーポリシー。"
>
  <PageHeader
    eyebrow="legal"
    title="特定商取引法に基づく表記・プライバシーポリシー"
    lead={`合同会社語音の特定商取引法に基づく表記、および個人情報の取り扱いについて。`}
  />
</BaseLayout>

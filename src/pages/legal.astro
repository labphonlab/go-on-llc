---
import BaseLayout from "../layouts/BaseLayout.astro";
import { u } from "../lib/url";

const tokushoho = [
  { k: "事業者名", v: "合同会社語音" },
  { k: "代表社員", v: "石原 健" },
  { k: "所在地", v: "東京都豊島区" },
  {
    k: "電話番号",
    v: "請求があった場合、遅滞なく開示いたします。お問い合わせフォームよりご請求ください。",
  },
  {
    k: "所在地の詳細",
    v: "請求があった場合、遅滞なく開示いたします。",
  },
  { k: "お問い合わせ", v: "本サイトの問い合わせフォーム", href: "/contact" },
  {
    k: "販売価格",
    v: "各プロダクトの販売ページ（App Store 等）に表示します。",
  },
  {
    k: "代金の支払時期・方法",
    v: "各配信プラットフォームの定めによります。App Store 経由のアプリおよびアプリ内課金は Apple が決済を行います。",
  },
  {
    k: "商品の引渡時期",
    v: "決済完了後、ただちにダウンロードまたは機能の利用が可能になります。",
  },
  {
    k: "返品・キャンセル",
    v: "デジタル商品の性質上、当社からの直接の返金は承っておりません。App Store 経由でご購入の場合、返金は Apple のポリシーに従い、Apple のサポート（reportaproblem.apple.com）へお申し出ください。",
  },
  {
    k: "動作環境",
    v: "各プロダクトの説明ページに記載します。",
    href: "/products",
  },
];
---

<BaseLayout
  title="特定商取引法に基づく表記・プライバシーポリシー"
  description="合同会社語音の特定商取引法に基づく表記およびプライバシーポリシー。"
>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-20">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">legal</p>
    <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight text-ink">
      特定商取引法に基づく表記・プライバシーポリシー
    </h1>

    <article id="tokushoho" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl text-ink">特定商取引法に基づく表記</h2>
      <dl class="mt-6 divide-y divide-line border-y border-line">
        {
          tokushoho.map((r) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-3.5 sm:grid-cols-[10rem_1fr]">
              <dt class="text-sm text-muted">{r.k}</dt>
              <dd class="text-sm leading-relaxed text-ink">
                {r.href ? <a href={u(r.href)}>{r.v}</a> : r.v}
              </dd>
            </div>
          ))
        }
      </dl>
    </article>

    <article id="privacy" class="mt-16 scroll-mt-24">
      <h2 class="font-display text-2xl text-ink">プライバシーポリシー</h2>

      <h3 class="mt-8 font-display text-lg text-ink">取得する情報と利用目的</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        当社は、お問い合わせフォームからご入力いただいたお名前・メールアドレス・お問い合わせ内容を取得します。これらは、お問い合わせへの回答および必要な連絡の目的にのみ利用します。
      </p>

      <h3 class="mt-8 font-display text-lg text-ink">アプリケーションで扱う情報</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        当社の音声分析アプリケーションは、録音した音声およびその解析結果を端末内で処理し、当社サーバーへ送信しません。本サイト上のツール（母音フォルマントチャート、波形・スペクトログラム表示、識別課題アプリ）についても、入力値・読み込んだ音声ファイル・測定結果はブラウザ内で処理され、送信されません。各アプリが取り扱う情報の詳細は、配信プラットフォーム上のプライバシー表示および<a
          href={u("/support")}>サポート</a
        >ページをご確認ください。
      </p>

      <h3 class="mt-8 font-display text-lg text-ink">第三者への提供・外部サービス</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        取得した個人情報を、法令に基づく場合を除き第三者に提供することはありません。ただし、お問い合わせフォームの送信処理には外部サービス Formspree
        を利用しており、送信内容は同サービスを経由します。また、本サイトは Google Fonts
        からWebフォントを読み込むため、閲覧時にアクセス元の情報が同サービスに送信されます。
      </p>

      <h3 class="mt-8 font-display text-lg text-ink">アクセス解析・Cookie</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        本サイトは、閲覧者を追跡するためのCookieおよびアクセス解析ツールを使用していません。
      </p>

      <h3 class="mt-8 font-display text-lg text-ink">保管と開示・訂正・削除</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        取得した個人情報は、利用目的の達成に必要な期間に限り保管し、不要となった時点で削除します。ご本人からの開示・訂正・利用停止・削除のご請求には、ご本人であることを確認のうえ、法令に従って対応いたします。<a
          href={u("/contact")}>お問い合わせフォーム</a
        >よりご連絡ください。
      </p>

      <h3 class="mt-8 font-display text-lg text-ink">改定</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        本ポリシーの内容は、法令の変更やサービス内容の変更に応じて改定することがあります。改定後の内容は本ページに掲載した時点から適用されます。
      </p>
    </article>
  </section>
</BaseLayout>

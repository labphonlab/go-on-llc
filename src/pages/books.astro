---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { u } from "../lib/url";
import { bookAreas } from "../data/catalog";
---

<BaseLayout
  title="出版"
  description="合同会社語音が編集・発行している書籍と電子書籍。音声学・言語学、英語教育・語学教材、日本語教育、一般書の4分野。"
>
  <PageHeader
    eyebrow="books"
    title="出版"
    lead={`音声学・言語学を中心に、書籍と電子書籍を編集・発行しています。研究の現場で使う手順書から、専門外の読者に向けた一般書までを扱います。`}
  />

  <section class="mx-auto max-w-5xl px-5 pb-24">
    <div class="grid gap-16">
      {
        bookAreas.map((a, i) => (
          <article id={a.id} class="scroll-mt-28">
            <div class="grid gap-x-12 gap-y-6 border-t border-line pt-10 sm:grid-cols-[1fr_1.15fr]">
              <div>
                <p class="ipa text-sm text-muted">
                  {String(i + 1).padStart(2, "0")}
                </p>
                <h2 class="mt-3 font-display text-2xl leading-snug text-ink sm:text-3xl">
                  {a.area}
                </h2>
                <p class="mt-4 leading-relaxed text-muted">
                  {a.summary}
                </p>
              </div>

              <div>
                <p class="eyebrow">主な書名</p>
                <ul class="mt-4">
                  {a.titles.map((t) => (
                    <li class="row py-3 font-display text-lg leading-snug text-ink">
                      {t}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-28">
    <div class="card p-7 sm:p-9">
      <h2 class="font-display text-xl text-ink">お求め・ご相談</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">
        書籍の入手方法、授業での教科書採用、電子書籍版の提供形式、執筆・監修のご依頼については、書名を添えてお問い合わせください。刊行予定の書目についてのご質問にもお答えします。
      </p>
      <a
        href={u("/contact")}
        class="mt-7 inline-block rounded-md bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline transition-opacity hover:opacity-85"
        >お問い合わせフォームへ</a
      >
    </div>
  </section>
</BaseLayout>

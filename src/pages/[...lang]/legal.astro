---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { u } from "../../lib/url";
import { localePaths, t, type Lang } from "../../i18n";
import { legal as copy } from "../../i18n/pages";

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };

const description = {
  ja: "合同会社語音の特定商取引法に基づく表記およびプライバシーポリシー。",
  en: "Go-on LLC's disclosure under Japan's Act on Specified Commercial Transactions, and our privacy policy.",
};
const authoritative = t(copy.authoritative, lang);
---

<BaseLayout
  lang={lang}
  path="/legal"
  title={t(copy.title, lang)}
  description={t(description, lang)}
>
  <PageHeader
    eyebrow={copy.eyebrow}
    title={t(copy.title, lang)}
    lead={t(copy.lead, lang)}
  >
    {
      authoritative && (
        <p class="mt-4 max-w-2xl border-l-2 border-amber pl-3 text-sm text-muted">
          {authoritative}
        </p>
      )
    }
  </PageHeader>

  <section class="mx-auto max-w-3xl px-5 pb-20">
    <article id="tokushoho" class="scroll-mt-28">
      <h2 class="font-display text-2xl text-ink">{t(copy.tokushohoHeading, lang)}</h2>
      <dl class="mt-6 divide-y divide-line border-y border-line">
        {
          copy.tokushoho.map((r) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-3.5 sm:grid-cols-[11rem_1fr]">
              <dt class="text-sm text-muted">{t(r.k, lang)}</dt>
              <dd class="text-sm leading-relaxed text-ink">
                {"href" in r && r.href ? (
                  <a href={u(r.href, lang)}>{t(r.v, lang)}</a>
                ) : (
                  t(r.v, lang)
                )}
                {"hint" in r && r.hint && (
                  <span class="block text-xs text-muted">{t(r.hint, lang)}</span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </article>

    <article id="privacy" class="mt-16 scroll-mt-28">
      <h2 class="font-display text-2xl text-ink">{t(copy.privacyHeading, lang)}</h2>
      {
        copy.privacy.map((s) => (
          <>
            <h3 class="mt-8 font-display text-lg text-ink">{t(s.h, lang)}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{t(s.p, lang)}</p>
          </>
        ))
      }
    </article>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { u } from "../../lib/url";
import { localePaths, t, type Lang } from "../../i18n";
import { legal as copy } from "../../i18n/pages";

/*
  プライバシーポリシーは単独ページ。アプリ内の設定画面が
  https://goonresearch.jp/privacy/ を指しているため、このパスが正典。
  本文は legal.privacy を共有しており、/legal 側からはここへ誘導する。
*/
export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };

const description = {
  ja: "合同会社語音のプライバシーポリシー。お問い合わせフォームで取得する情報、アプリケーションで扱う情報、外部サービスの利用について。",
  en: "Go-on LLC's privacy policy: what the contact form collects, what our applications handle, and which external services are involved.",
};
---

<BaseLayout
  lang={lang}
  path="/privacy"
  title={t(copy.privacyHeading, lang)}
  description={t(description, lang)}
>
  <PageHeader
    eyebrow="privacy"
    title={t(copy.privacyHeading, lang)}
    lead={t(description, lang)}
  />

  <section class="container-prose pb-24">
    {
      copy.privacy.map((s) => (
        <>
          <h2 class="mt-10 font-display text-lg text-ink first:mt-0">{t(s.h, lang)}</h2>
          <p class="mt-3 leading-relaxed text-muted">{t(s.p, lang)}</p>
        </>
      ))
    }

    <p class="mt-12 border-t border-line pt-6 text-sm text-muted">
      <a href={u("/legal", lang)}>{t(copy.tokushohoHeading, lang)}</a>
    </p>
  </section>
</BaseLayout>

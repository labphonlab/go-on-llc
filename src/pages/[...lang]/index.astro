---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { u } from "../../lib/url";
import { localePaths, t, type Lang } from "../../i18n";
import { home } from "../../i18n/pages";
import { tools, datasets } from "../../data/catalog";

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
---

<BaseLayout lang={lang} path="/">
  <!--
    Hero: 社名そのものが事業領域なので、辞書の見出し語のかたちで見せる。
    見出し語 → 読み・音声表記・語義 の3段は、そのまま会社の説明になる。
  -->
  <section class="mx-auto max-w-5xl px-5 pt-16 pb-20 sm:pt-24 sm:pb-24">
    <p class="eyebrow">{home.eyebrow}</p>

    <h1
      class="mt-8 font-display font-medium leading-[0.85] tracking-tight text-ink"
      style="font-size: var(--text-hero)"
    >
      語音
    </h1>

    <dl
      class="mt-8 flex flex-wrap items-baseline gap-x-7 gap-y-2 border-t border-line pt-5 text-base sm:text-lg"
    >
      <div>
        <dt class="sr-only">reading</dt>
        <dd class="text-muted">{t(home.reading, lang)}</dd>
      </div>
      <div>
        <dt class="sr-only">transcription</dt>
        <dd class="ipa text-ink">/ɡo.oɴ/</dd>
      </div>
      <div>
        <dt class="sr-only">gloss</dt>
        <dd class="ipa text-muted">{t(home.gloss, lang)}</dd>
      </div>
    </dl>

    <p
      class="mt-14 max-w-2xl font-display leading-[1.35] whitespace-pre-line text-ink"
      style="font-size: var(--text-lead)"
    >
      {t(home.lead, lang)}
    </p>
    <p class="mt-6 max-w-xl leading-relaxed text-muted">{t(home.intro, lang)}</p>

    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm">
      <a
        href={u("/products", lang)}
        class="group inline-flex items-center gap-2 font-medium text-ink no-underline"
        >{t(home.ctaProducts, lang)}
        <span class="text-muted transition-transform group-hover:translate-x-0.5">→</span></a
      >
      <a href="#services" class="text-muted no-underline transition-colors hover:text-ink"
        >{t(home.ctaServices, lang)}</a
      >
      <a
        href={u("/contact", lang)}
        class="text-muted no-underline transition-colors hover:text-ink"
        >{t(home.ctaContact, lang)}</a
      >
    </div>
  </section>

  <!-- いま使えるもの -->
  <section class="mx-auto max-w-5xl px-5 pb-24">
    <div class="border-t border-line pt-12">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="eyebrow">{t(home.productsHeading, lang)}</h2>
        <a
          href={u("/products", lang)}
          class="text-sm text-muted no-underline transition-colors hover:text-ink"
          >{t(home.productsAll, lang)} →</a
        >
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          tools.map((p) => (
            <a
              href={u("/products", lang)}
              class="card flex flex-col gap-2 p-7 no-underline"
            >
              <p class="text-xs text-muted">{t(p.kind, lang)}</p>
              <h3 class="font-display text-lg leading-snug text-ink">{t(p.name, lang)}</h3>
              <p class="text-sm leading-relaxed text-muted">{t(p.summary, lang)}</p>
            </a>
          ))
        }
      </div>

      <p class="mt-8 text-sm text-muted">{t(home.productsNote, lang)}</p>
    </div>
  </section>

  <!-- 事業内容 -->
  <section id="services" class="mx-auto max-w-5xl px-5 pb-24 scroll-mt-24">
    <div class="border-t border-line pt-12">
      <h2 class="eyebrow">{t(home.servicesHeading, lang)}</h2>
      <div class="mt-8">
        {
          home.services.map((s, i) => (
            <div class="row grid grid-cols-[2.5rem_1fr] gap-x-4 py-7 sm:grid-cols-[4rem_1fr] sm:gap-x-8">
              <span class="ipa pt-1.5 text-sm text-muted">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="font-display text-xl leading-snug text-ink">{t(s.t, lang)}</h3>
                <p class="mt-2 max-w-2xl leading-relaxed text-muted">{t(s.d, lang)}</p>
                <a
                  href={u(s.href, lang)}
                  class="mt-3 inline-block text-sm text-muted no-underline underline-offset-[7px] transition-colors hover:text-ink hover:underline"
                >
                  {t(s.cta, lang)} <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 研究・サポート -->
  <section class="mx-auto max-w-5xl px-5 pb-28">
    <div class="grid gap-10 border-t border-line pt-12 sm:grid-cols-2 sm:gap-16">
      <div>
        <p class="ipa text-sm text-muted">[ ɹɪˈsɜːtʃ ]</p>
        <h2 class="mt-2 font-display text-2xl leading-snug text-ink">
          {t(home.researchHeading, lang)}
        </h2>
        <p class="mt-4 leading-relaxed text-muted">{t(home.researchBody, lang)}</p>
        <a
          href={u("/research", lang)}
          class="group mt-5 inline-flex items-center gap-2 text-sm font-medium text-ink no-underline"
          >{t(home.researchCta, lang)}
          <span class="text-muted transition-transform group-hover:translate-x-0.5">→</span></a
        >
      </div>

      <div>
        <p class="ipa text-sm text-muted">[ səˈpɔːt ]</p>
        <h2 class="mt-2 font-display text-2xl leading-snug text-ink">
          {t(home.supportHeading, lang)}
        </h2>
        <p class="mt-4 leading-relaxed text-muted">{t(home.supportBody, lang)}</p>
        <a
          href={u("/support", lang)}
          class="group mt-5 inline-flex items-center gap-2 text-sm font-medium text-ink no-underline"
          >{t(home.supportCta, lang)}
          <span class="text-muted transition-transform group-hover:translate-x-0.5">→</span></a
        >
      </div>
    </div>
  </section>
</BaseLayout>

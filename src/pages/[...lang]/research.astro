---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { u } from "../../lib/url";
import { localePaths, t, type Lang } from "../../i18n";
import { research as copy } from "../../i18n/pages";
import { datasets } from "../../data/catalog";

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };

const description = {
  ja: "合同会社語音の研究活動と、論文に伴って公開しているデータセット・解析コードの一覧。音声学・音韻論・コーパス言語学。",
  en: "Research at Go-on LLC and the datasets and analysis code published alongside each paper. Phonetics, phonology and corpus linguistics.",
};
---

<BaseLayout
  lang={lang}
  path="/research"
  title={t(copy.title, lang)}
  description={t(description, lang)}
>
  <PageHeader
    eyebrow={copy.eyebrow}
    title={t(copy.title, lang)}
    lead={t(copy.lead, lang)}
  />

  <section class="mx-auto max-w-5xl px-5 pb-16">
    <h2 class="eyebrow">{t(copy.areasHeading, lang)}</h2>
    <div class="mt-8 grid gap-x-12 gap-y-8 sm:grid-cols-2">
      {
        copy.areas.map((a) => (
          <div>
            <h3 class="font-display text-xl leading-snug text-ink">{t(a.t, lang)}</h3>
            <p class="mt-2 leading-relaxed text-muted">{t(a.d, lang)}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-16">
    <div class="border-t border-line pt-12">
      <h2 class="font-display text-2xl text-ink">{t(copy.dataHeading, lang)}</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">{t(copy.dataBody, lang)}</p>
      <div class="mt-8 border-t border-line">
        {
          datasets.map((d) => (
            <article class="row py-7">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="ipa text-lg text-ink">{d.title}</h3>
                <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
                  {t(d.venue, lang)}
                </span>
              </div>
              <p
                lang="en"
                class="mt-2 max-w-3xl font-display text-base leading-snug text-ink"
              >
                {d.paper}
              </p>
              <p class="mt-2 max-w-3xl leading-relaxed text-muted">{t(d.summary, lang)}</p>
              <a
                href={d.href}
                class="mt-3 inline-block text-sm font-medium text-ink no-underline underline-offset-[7px] hover:underline"
              >
                {t(copy.repoCta, lang)} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-muted">
        <a href="https://github.com/labphonlab">{t(copy.moreRepos, lang)}</a>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-24">
    <div class="border-t border-line pt-12">
      <h2 class="font-display text-2xl text-ink">{t(copy.collabHeading, lang)}</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">
        {t(copy.collabBody, lang)}
      </p>
      <a
        href={u("/contact", lang)}
        class="mt-5 inline-block text-sm font-medium text-ink no-underline underline-offset-[7px] hover:underline"
        >{lang === "ja" ? "お問い合わせ" : "Contact us"} <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</BaseLayout>

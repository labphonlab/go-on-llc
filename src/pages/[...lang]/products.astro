---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { u } from "../../lib/url";
import { localePaths, ui, t, type Lang } from "../../i18n";
import { products as copy } from "../../i18n/pages";
import { tools, inDevelopment, STATUS_LABEL } from "../../data/catalog";

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };

const description = {
  ja: "合同会社語音が開発しているソフトウェア。Praat JA（Praatの日本語GUI）、母音フォルマントチャート、音声知覚の識別課題アプリ。",
  en: "Software developed by Go-on LLC: Praat JA (a Japanese GUI for Praat), the Vowel Formant Chart, and the Speech Identification Task.",
};
---

<BaseLayout
  lang={lang}
  path="/products"
  title={t(copy.title, lang)}
  description={t(description, lang)}
>
  <PageHeader
    eyebrow={copy.eyebrow}
    title={t(copy.title, lang)}
    lead={t(copy.lead, lang)}
  />

  <section class="container-page pb-16">
    <h2 class="eyebrow">{t(copy.releasedHeading, lang)}</h2>
    <div class="mt-8 grid gap-5">
      {
        tools.map((p) => (
          <article class="card p-7 sm:p-9">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h2 class="font-display leading-snug text-ink" style="font-size: var(--text-section-title)">{t(p.name, lang)}</h2>
              <span class="text-xs text-muted">{t(p.kind, lang)}</span>
            </div>
            <p class="mt-3 max-w-3xl text-ink">{t(p.summary, lang)}</p>
            <p class="mt-3 max-w-3xl leading-relaxed text-muted">{t(p.detail, lang)}</p>
            <p class="mt-4 text-sm text-muted">
              <span class="text-xs tracking-wider text-muted">
                {t(copy.requirements, lang)}
              </span>{" "}
              {t(p.platforms, lang)}
            </p>
            {p.note && (
              <p class="mt-4 max-w-3xl border-l-2 border-amber pl-3 text-xs leading-relaxed text-muted">
                {t(p.note, lang)}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page pb-16">
    <div class="border-t border-line pt-12">
      <h2 class="eyebrow">{t(copy.devHeading, lang)}</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">{t(copy.devLead, lang)}</p>

      <div class="mt-8">
        {
          inDevelopment.map((p) => (
            <article class="row py-7">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-display text-xl leading-snug text-ink">
                  {t(p.name, lang)}
                  {p.reading && (
                    <span class="ml-2 text-sm text-muted">（{t(p.reading, lang)}）</span>
                  )}
                </h3>
                <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
                  {t(STATUS_LABEL[p.status], lang)}
                </span>
                <span class="text-xs text-faint">
                  {t(p.kind, lang)} · {t(p.platforms, lang)}
                </span>
              </div>
              <p class="mt-3 text-ink">{t(p.summary, lang)}</p>
              <p class="mt-2 max-w-3xl leading-relaxed text-muted">{t(p.detail, lang)}</p>
              {p.supportPath && (
                <a
                  href={u(p.supportPath, lang)}
                  class="mt-3 inline-block text-sm font-medium text-ink no-underline underline-offset-[7px] hover:underline"
                >
                  {lang === "ja" ? "詳しい仕様とサポート" : "Specifications and support"}{" "}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page pb-24">
    <div class="card p-7 sm:p-9">
      <h2 class="font-display text-xl text-ink">{t(copy.accessHeading, lang)}</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">{t(copy.accessBody, lang)}</p>
      <a
        href={u("/contact", lang)}
        class="mt-7 inline-block rounded-md bg-ink px-6 py-3 text-sm font-medium text-paper no-underline transition-opacity hover:opacity-85"
        >{t(ui.contactCta, lang)}</a
      >
    </div>
  </section>
</BaseLayout>

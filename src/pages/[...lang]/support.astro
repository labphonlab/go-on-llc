---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { u } from "../../lib/url";
import { localePaths, ui, t, type Lang } from "../../i18n";
import { support as copy } from "../../i18n/pages";
import { tools } from "../../data/catalog";

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };

const description = {
  ja: "合同会社語音の製品サポート。Praat JA・母音フォルマントチャート・音声知覚識別課題アプリの使い方と注意点、不具合の報告方法、データの取り扱いについて。",
  en: "Product support for Go-on LLC: notes on Praat JA, the Vowel Formant Chart and the Speech Identification Task, how to report a bug, and how data is handled.",
};
---

<BaseLayout
  lang={lang}
  path="/support"
  title={t(copy.title, lang)}
  description={t(description, lang)}
>
  <PageHeader
    eyebrow={copy.eyebrow}
    title={t(copy.title, lang)}
    lead={t(copy.lead, lang)}
  />

  <section class="mx-auto max-w-3xl px-5 pb-16">
    <div class="card p-7 sm:p-9">
      <h2 class="font-display text-xl text-ink">{t(copy.deskHeading, lang)}</h2>
      <p class="mt-3 leading-relaxed text-muted">{t(copy.deskBody, lang)}</p>
      <ol class="mt-4 grid gap-1.5 text-sm text-ink">
        {
          copy.reportItems.map((item, i) => (
            <li class="grid grid-cols-[1.75rem_1fr] items-baseline">
              <span class="ipa text-sm text-muted">{String(i + 1).padStart(2, "0")}</span>
              <span>{t(item, lang)}</span>
            </li>
          ))
        }
      </ol>
      <a
        href={u("/contact", lang)}
        class="mt-6 inline-block rounded-md bg-ink px-6 py-3 text-sm font-medium text-paper no-underline transition-opacity hover:opacity-85"
        >{t(ui.contactCta, lang)}</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16">
    <h2 class="eyebrow">{t(copy.productsHeading, lang)}</h2>
    <p class="mt-4 leading-relaxed text-muted">{t(copy.productsBody, lang)}</p>
    <div class="mt-8 grid gap-5">
      {
        tools.map((p) => (
          <article id={p.id} class="card scroll-mt-28 p-7 sm:p-9">
            <h3 class="font-display text-xl text-ink">{t(p.name, lang)}</h3>
            <p class="mt-1 text-sm text-muted">
              {t(p.kind, lang)} · {t(copy.requirements, lang)}: {t(p.platforms, lang)}
            </p>
            {p.support && (
              <ul class="mt-4 grid gap-2.5 text-sm leading-relaxed text-muted">
                {p.support.map((line) => (
                  <li class="grid grid-cols-[0.75rem_1fr] gap-x-2">
                    <span aria-hidden="true" class="text-line">
                      —
                    </span>
                    <span>{t(line, lang)}</span>
                  </li>
                ))}
              </ul>
            )}
            {p.note && (
              <p class="mt-4 border-l-2 border-amber pl-3 text-xs leading-relaxed text-muted">
                {t(p.note, lang)}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-24">
    <div class="border-t border-line pt-12">
      <h2 class="eyebrow">{t(copy.faqHeading, lang)}</h2>

      <!--
        絞り込みは進歩的強化。JSが無くても全項目がそのまま読める（回答はHTMLに
        含まれるので検索エンジンにも渡る）。
      -->
      <div class="mt-6" data-faq data-count-suffix={t(copy.faqCount, lang)}>
        <label class="grid gap-1.5">
          <span class="sr-only">{t(copy.faqFilterLabel, lang)}</span>
          <input
            type="search"
            data-faq-input
            placeholder={t(copy.faqFilter, lang)}
            class="w-full rounded-md border border-line bg-white px-3 py-2 text-ink transition-colors focus:border-ink focus:outline-none"
          />
        </label>
        <p class="mt-2 text-xs text-muted" data-faq-count aria-live="polite"></p>

        <div class="mt-6 border-t border-line">
          {
            copy.faq.map((item) => (
              <details id={item.id} class="row scroll-mt-28 py-1" data-faq-item>
                <summary class="cursor-pointer list-none py-4 font-display text-lg leading-snug text-ink marker:content-['']">
                  {t(item.q, lang)}
                </summary>
                <div class="pb-5 text-sm leading-relaxed text-muted">
                  <p>{t(item.a, lang)}</p>
                  {"link" in item && item.link && (
                    <a
                      href={u(item.link.href, lang)}
                      class="mt-2 inline-block font-medium text-ink no-underline underline-offset-[7px] hover:underline"
                    >
                      {t(item.link.label, lang)} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </details>
            ))
          }
        </div>

        <p class="mt-6 hidden text-sm text-muted" data-faq-empty>
          {t(copy.faqEmpty, lang)}
        </p>
      </div>

      <p class="mt-8 leading-relaxed text-muted">
        <a href={u("/contact", lang)}>{t(copy.faqFooter, lang)}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // FAQ の絞り込み。該当件数を読み上げ、ヒットした項目は開いた状態で示す。
  const root = document.querySelector<HTMLElement>("[data-faq]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-faq-input]")!;
    const items = [...root.querySelectorAll<HTMLDetailsElement>("[data-faq-item]")];
    const count = root.querySelector<HTMLElement>("[data-faq-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-faq-empty]")!;
    const suffix = root.dataset.countSuffix ?? "";

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let hits = 0;
      for (const item of items) {
        const match = !q || (item.textContent ?? "").toLowerCase().includes(q);
        item.hidden = !match;
        item.open = Boolean(q) && match;
        if (match) hits++;
      }
      count.textContent = q ? `${hits}${suffix}` : "";
      empty.classList.toggle("hidden", hits > 0);
    };

    input.addEventListener("input", apply);

    // /support#purchase のような直リンクは、その項目を開いて見せる。
    const openFromHash = () => {
      const target = location.hash ? document.querySelector(location.hash) : null;
      if (target instanceof HTMLDetailsElement) target.open = true;
    };
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  }
</script>

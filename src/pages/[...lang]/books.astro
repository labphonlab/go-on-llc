---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { u } from "../../lib/url";
import { localePaths, ui, t, type Lang } from "../../i18n";
import { books as copy } from "../../i18n/pages";
import { bookAreas } from "../../data/catalog";

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };

const description = {
  ja: "合同会社語音が編集・発行している書籍と電子書籍。音声学・言語学、英語教育・語学教材、日本語教育、一般書の4分野。",
  en: "Books and ebooks edited and published by Go-on LLC, across four areas: phonetics and linguistics, English language teaching, teaching Japanese, and general readership.",
};
const note = t(copy.languageNote, lang);
---

<BaseLayout
  lang={lang}
  path="/books"
  title={t(copy.title, lang)}
  description={t(description, lang)}
>
  <PageHeader
    eyebrow={copy.eyebrow}
    title={t(copy.title, lang)}
    lead={t(copy.lead, lang)}
  >
    {note && <p class="mt-4 max-w-2xl text-sm text-muted">{note}</p>}
  </PageHeader>

  <section class="container-page pb-24">
    <div class="grid gap-16">
      {
        bookAreas.map((a, i) => (
          <article id={a.id} class="scroll-mt-28">
            <div class="grid gap-x-12 gap-y-8 border-t border-line pt-10 lg:grid-cols-[1fr_1.15fr]">
              <div>
                <p class="ipa text-sm text-muted">{String(i + 1).padStart(2, "0")}</p>
                <h2 class="mt-3 font-display leading-snug text-ink" style="font-size: var(--text-section-title)">
                  {t(a.area, lang)}
                </h2>
                <p class="mt-4 leading-relaxed text-muted">{t(a.summary, lang)}</p>
              </div>

              <div>
                <p class="eyebrow">{t(copy.titlesLabel, lang)}</p>
                <ul class="mt-4">
                  {a.titles.map((title) => (
                    <li class="row py-3 font-display text-lg leading-snug text-ink">
                      {t(title, lang)}
                      {lang === "en" && (
                        <span class="mt-0.5 block font-body text-xs text-faint">
                          {t(title, "ja")}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page pb-28">
    <div class="card p-7 sm:p-9">
      <h2 class="font-display text-xl text-ink">{t(copy.ctaHeading, lang)}</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">{t(copy.ctaBody, lang)}</p>
      <a
        href={u("/contact", lang)}
        class="mt-7 inline-block rounded-md bg-ink px-6 py-3 text-sm font-medium text-paper no-underline transition-opacity hover:opacity-85"
        >{t(ui.contactCta, lang)}</a
      >
    </div>
  </section>
</BaseLayout>

---
import { u } from "../lib/url";
import { ui, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** 言語プレフィックスを含まないルート（例: "/products"）。言語切り替えに使う。 */
  path: string;
}
const { lang, path } = Astro.props;

/* ロゴがホームを兼ねるので、ナビに「ホーム」は置かない。 */
const nav = [
  { href: "/products", label: ui.nav.products },
  { href: "/books", label: ui.nav.books },
  { href: "/research", label: ui.nav.research },
  { href: "/support", label: ui.nav.support },
  { href: "/about", label: ui.nav.about },
  { href: "/contact", label: ui.nav.contact },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const other: Lang = lang === "ja" ? "en" : "ja";
const otherLabel = other === "en" ? "English" : "日本語";
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-sm">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-4"
  >
    <a
      href={u("/", lang)}
      class="group shrink-0 no-underline"
      aria-label={t(ui.homeAria, lang)}
    >
      <span class="font-display text-xl font-medium tracking-tight text-ink">語音</span>
      <span class="ipa ml-2 text-sm text-muted">/ɡo.oɴ/</span>
    </a>

    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
      <nav aria-label={t(ui.mainNavAria, lang)}>
        <ul class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-sm">
          {
            nav.map((item) => (
              <li>
                <a
                  href={u(item.href, lang)}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "no-underline underline-offset-[7px] decoration-1 transition-colors",
                    isActive(item.href)
                      ? "text-ink underline decoration-ink"
                      : "text-muted hover:text-ink",
                  ]}
                >
                  {t(item.label, lang)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a
        href={u(path, other)}
        lang={other}
        hreflang={other}
        aria-label={t(ui.langSwitchAria, lang)}
        class="border-l border-line pl-5 text-sm text-muted no-underline transition-colors hover:text-ink"
        >{otherLabel}</a
      >
    </div>
  </div>
</header>

---
import { u } from "../lib/url";

/* ロゴがホームを兼ねるので、ナビに「ホーム」は置かない。 */
const nav = [
  { href: "/products", label: "プロダクト" },
  { href: "/books", label: "出版" },
  { href: "/research", label: "研究" },
  { href: "/support", label: "サポート" },
  { href: "/about", label: "会社概要" },
  { href: "/contact", label: "お問い合わせ" },
];

// Astro.url.pathname は base を含むので、u(href) と突き合わせる。
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  const target = u(href).replace(/\/$/, "") || "/";
  return path === target || path.startsWith(`${target}/`);
};
---

<header
  class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-sm"
>
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-4"
  >
    <a
      href={u("/")}
      class="group shrink-0 no-underline"
      aria-label="合同会社語音 ホーム"
    >
      <span class="font-display text-xl font-medium tracking-tight text-ink"
        >語音</span
      >
      <span class="ipa ml-2 text-sm text-muted">/ɡo.oɴ/</span>
    </a>
    <nav aria-label="メインナビゲーション">
      <ul class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={u(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "no-underline underline-offset-[7px] decoration-1 transition-colors",
                  isActive(item.href)
                    ? "text-ink underline decoration-ink"
                    : "text-muted hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

---
import { u } from "../lib/url";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "プロダクト",
    items: [
      { href: "/products", label: "プロダクト一覧" },
      { href: "/books", label: "出版" },
      { href: "/support", label: "サポート" },
    ],
  },
  {
    heading: "研究",
    items: [
      { href: "/research", label: "研究とデータ公開" },
      { href: "https://github.com/labphonlab", label: "GitHub" },
    ],
  },
  {
    heading: "会社",
    items: [
      { href: "/about", label: "会社概要" },
      { href: "/contact", label: "お問い合わせ" },
      { href: "/legal#tokushoho", label: "特定商取引法に基づく表記" },
      { href: "/legal#privacy", label: "プライバシーポリシー" },
    ],
  },
];
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-5xl px-5 py-10">
    <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:gap-16">
      <div>
        <p class="font-display text-base text-ink">
          語音 <span class="ipa ml-1 text-sm text-muted">/ɡo.oɴ/</span>
        </p>
        <p class="mt-2 text-sm text-muted">
          合同会社語音（Go-on LLC）<br />
          音声・言語・教育・情報技術
        </p>
      </div>
      <nav
        aria-label="フッターナビゲーション"
        class="grid gap-8 text-sm sm:grid-cols-3 sm:gap-12"
      >
        {
          columns.map((col) => (
            <div>
              <p class="text-xs uppercase tracking-[0.2em] text-muted">
                {col.heading}
              </p>
              <ul class="mt-3 grid gap-1.5 [&_a]:no-underline [&_a]:text-muted [&_a]:transition-colors [&_a:hover]:text-ink">
                {col.items.map((item) => (
                  <li>
                    <a href={u(item.href)}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <p class="mt-10 border-t border-line pt-6 text-xs text-muted">
      © {year} Go-on LLC
    </p>
  </div>
</footer>

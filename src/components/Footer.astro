---
import { u } from "../lib/url";
import { ui, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();

const columns = [
  {
    heading: ui.footer.columns.products,
    items: [
      { href: "/products", label: ui.nav.products },
      { href: "/books", label: ui.nav.books },
      { href: "/support", label: ui.nav.support },
    ],
  },
  {
    heading: ui.footer.columns.research,
    items: [
      { href: "/research", label: ui.nav.research },
      { href: "https://github.com/labphonlab", label: { ja: "GitHub", en: "GitHub" } },
    ],
  },
  {
    heading: ui.footer.columns.company,
    items: [
      { href: "/about", label: ui.nav.about },
      { href: "/contact", label: ui.nav.contact },
      { href: "/legal#tokushoho", label: ui.footer.legalTokusho },
      { href: "/legal#privacy", label: ui.footer.legalPrivacy },
    ],
  },
];
---

<footer class="mt-24 border-t border-line">
  <div class="container-page py-10">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:gap-16">
      <div>
        <p class="font-display text-base text-ink">
          語音 <span class="ipa ml-1 text-sm text-muted">/ɡo.oɴ/</span>
        </p>
        <p class="mt-2 text-sm text-muted">
          {t(ui.siteNameFull, lang)}<br />
          {t(ui.footer.blurb, lang)}
        </p>
      </div>
      <nav
        aria-label={t(ui.footerNavAria, lang)}
        class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3 sm:gap-10 md:gap-12"
      >
        {
          columns.map((col) => (
            <div>
              <p class="eyebrow">{t(col.heading, lang)}</p>
              <ul class="mt-2 grid [&_a]:inline-block [&_a]:py-2 [&_a]:text-muted [&_a]:no-underline [&_a]:transition-colors [&_a:hover]:text-ink">
                {col.items.map((item) => (
                  <li>
                    <a href={u(item.href, lang)}>{t(item.label, lang)}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <p class="mt-10 border-t border-line pt-6 text-xs text-muted">© {year} Go-on LLC</p>
  </div>
</footer>

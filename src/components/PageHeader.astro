---
/** 下層ページ共通の導入部。eyebrow → 見出し → リード文の3段を全ページで揃える。 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="container-page pt-14 pb-12 sm:pt-20 sm:pb-14 lg:pt-28 lg:pb-16">
  <p class="eyebrow">{eyebrow}</p>
  <h1
    class="mt-5 font-display font-medium leading-[1.15] tracking-tight text-ink"
    style="font-size: var(--text-page-title)"
  >
    {title}
  </h1>
  {
    lead && (
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{lead}</p>
    )
  }
  <slot />
</header>

---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { u } from "../lib/url";
import { LANGS, htmlLang, ui, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** 言語プレフィックスを含まないルート（例: "/products"）。canonical と hreflang に使う。 */
  path: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const DEFAULTS = {
  title: {
    ja: "合同会社語音 | Go-on LLC — 音声・言語・教育",
    en: "Go-on LLC — speech, language, education",
  },
  description: {
    ja: "合同会社語音（Go-on LLC）は、音声・言語・教育・情報技術を軸に、音声分析ソフトウェアと語学学習アプリの開発、書籍の発行、音声学の研究とデータ公開を行う法人です。",
    en: "Go-on LLC works across speech, language, education and technology: developing speech analysis software and language-learning applications, publishing books, and carrying out phonetic research with open data.",
  },
};

const { lang, path, title, description, noindex = false } = Astro.props;

const siteName = t(ui.siteName, lang);
const resolvedTitle = title ?? t(DEFAULTS.title, lang);
const pageTitle = resolvedTitle.includes(siteName)
  ? resolvedTitle
  : `${resolvedTitle} | ${siteName}`;
const pageDescription = description ?? t(DEFAULTS.description, lang);

const canonical = new URL(u(path, lang), Astro.site).href;
const ogImage = new URL(u("/og.png"), Astro.site).href;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "合同会社語音",
  alternateName: "Go-on LLC",
  url: new URL(u("/"), Astro.site).href,
  logo: ogImage,
  description: t(DEFAULTS.description, "ja"),
  address: {
    "@type": "PostalAddress",
    postalCode: "170-0012",
    addressRegion: "東京都",
    addressLocality: "豊島区",
    streetAddress: "上池袋4-10-8-709",
    addressCountry: "JP",
  },
  telephone: "+81-70-9481-0649",
  founder: { "@type": "Person", name: "石原 健" },
  knowsAbout: ["音声学", "音韻論", "音声分析", "言語教育", "コーパス言語学"],
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    {
      !noindex &&
        LANGS.map((l) => (
          <link
            rel="alternate"
            hreflang={htmlLang[l]}
            href={new URL(u(path, l), Astro.site).href}
          />
        ))
    }
    {
      !noindex && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(u(path, "ja"), Astro.site).href}
        />
      )
    }
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={u("/sitemap.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      フォントは自己ホスト（public/fonts、@font-face は global.css）。
      外部CDNを使わないので、閲覧時に第三者へ接続元の情報が渡らない。
      和文は端末のフォントにまかせている。
    -->

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:px-3 focus:py-2"
      >{t(ui.skipToContent, lang)}</a
    >
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
